{
  "name": "@breazy/kit",
  "version": "0.1.0",
  "description": "The shared standard every app in Brendon's portfolio installs. Consent, events, identity, mail and security, extracted from code already running in production.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brendon1109/breazy-kit.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "default": "./dist/identity/index.js"
    },
    "./consent": {
      "types": "./dist/consent/index.d.ts",
      "default": "./dist/consent/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./mail": {
      "types": "./dist/mail/index.d.ts",
      "default": "./dist/mail/index.js"
    },
    "./guard": {
      "types": "./dist/guard/index.d.ts",
      "default": "./dist/guard/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run clean && npm run build && npm run test"
  },
  "peerDependencies": {
    "resend": ">=4"
  },
  "peerDependenciesMeta": {
    "resend": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
